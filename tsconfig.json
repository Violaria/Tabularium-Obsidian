{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "inlineSourceMap": true,
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2018",
        "allowJs": true,
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        "types": ["svelte", "node", "pouchdb-replication", "pouchdb-adapter-http", "pouchdb-mapreduce"],
        // "importsNotUsedAsValues": "error",
        "importHelpers": false,
        "alwaysStrict": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noImplicitOverride": true,
        "noEmit": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Intl"],
        "strictBindCallApply": true,
        "strictFunctionTypes": true,
        "paths": {
            "@/*": ["./src/*"],
            "@lib/*": ["./packages/sync-core/src/*"]
        }
    },
    // The sync core declares the untyped PouchDB modules it uses here; it is type-checked from its sources.
    "files": ["packages/sync-core/src/replication/couchdb/pouchdb-checkpoints.d.ts"],
    "include": ["**/*.ts", "test/**/*.test.ts", "**/*.unit.spec.ts", "**/*.svelte"],
    "exclude": [
        "pouchdb-browser-webpack",
        "packages",
        "utils",
        "src/apps",
        "src/**/*.test.ts",
        "**/_test/**",
        "test/styles/*.deno.ts"
    ]
}
