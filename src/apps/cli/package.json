{
    "name": "self-hosted-livesync-cli",
    "private": true,
    "version": "1.0.40-cli",
    "main": "dist/index.cjs",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "cli": "node dist/index.cjs",
        "buildRun": "npm run build && npm run cli --",
        "check": "tsc -p tsconfig.json",
        "test:unit": "cd ../../.. && npx vitest run --config vitest.config.unit.ts src/apps/cli/main.unit.spec.ts src/apps/cli/main.bootstrap.unit.spec.ts src/apps/cli/settingsPersistence.unit.spec.ts src/apps/cli/services/NodeLocalStorage.unit.spec.ts src/apps/cli/commands/utils.unit.spec.ts src/apps/cli/commands/runCommand.unit.spec.ts src/apps/cli/commands/daemonCommand.unit.spec.ts src/apps/cli/adapters/NodeFileSystemAdapter.unit.spec.ts",
        "test:e2e:two-vaults:common": "bash test/test-e2e-two-vaults-common.sh",
        "test:e2e:two-vaults:matrix": "bash test/test-e2e-two-vaults-matrix.sh",
        "test:e2e:push-pull": "bash test/test-push-pull-linux.sh",
        "test:e2e:sync-two-local": "bash test/test-sync-two-local-databases-linux.sh",
        "pretest:e2e:ci": "npm run build",
        "test:e2e:ci": "deno task --cwd testdeno test:ci",
        "test:e2e:mirror": "bash test/test-mirror-linux.sh",
        "test:e2e:remote-commands": "bash test/test-remote-commands-linux.sh",
        "pretest:e2e:all": "npm run build",
        "test:e2e:all": "deno task --cwd testdeno test:ci"
    },
    "dependencies": {
        "chokidar": "^4.0.0",
        "minimatch": "^10.2.5",
        "octagonal-wheels": "^0.1.55",
        "pouchdb-adapter-http": "^9.0.0",
        "pouchdb-adapter-leveldb": "^9.0.0",
        "pouchdb-core": "^9.0.0",
        "pouchdb-errors": "^9.0.0",
        "pouchdb-find": "^9.0.0",
        "pouchdb-mapreduce": "^9.0.0",
        "pouchdb-merge": "^9.0.0",
        "pouchdb-replication": "^9.0.0",
        "pouchdb-utils": "^9.0.0",
        "transform-pouch": "^2.0.0",
        "werift": "^0.24.4"
    },
    "devDependencies": {
        "typescript": "6.0.3",
        "vite": "^8.0.16",
        "vitest": "^4.1.11"
    }
}
