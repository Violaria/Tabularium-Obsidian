{
    "name": "tabularium-obsidian",
    "version": "1.1.1",
    "description": "Reflect your vault changes to some other devices immediately. Please make sure to disable other synchronize solutions to avoid content corruption or duplication.",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node --env-file=.env esbuild.config.mjs",
        "build:core": "npm run build --workspace @tabularium/sync-core",
        "prebuild": "npm run build:core",
        "build": "node esbuild.config.mjs production",
        "buildDev": "node esbuild.config.mjs dev",
        "lint": "eslint --cache --cache-strategy content --concurrency off --max-warnings 0 src",
        "lint:community": "eslint --config eslint.community.config.mjs --concurrency off --max-warnings 0 src",
        "lint:community:core": "eslint --config eslint.community.config.mjs --concurrency off --quiet packages/sync-core/src",
        "lint:community:tools": "eslint --config eslint.community.config.mjs --concurrency off --max-warnings 0 _tools",
        "svelte-check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "tsc-check": "tsc --noEmit",
        "pretty:json": "prettier --config ./.prettierrc.mjs \"**/*.json\" --write --log-level error",
        "pretty": "npm run prettyNoWrite -- --write --log-level error",
        "prettyCheck": "npm run prettyNoWrite -- --check",
        "prettyNoWrite": "prettier --config ./.prettierrc.mjs \"**/*.js\" \"**/*.ts\" \"**/*.json\" ",
        "precheck:compatibility": "npm run build",
        "check:compatibility": "node utils/check-compatibility.js --file main.js --ios 15",
        "precheck": "npm run build:core",
        "check": "npm run tsc-check && npm run lint && npm run lint:community && npm run lint:community:tools && npm run lint:community:core && npm run svelte-check && npm run check:compatibility && npm run i18n:check && npm run check:style-classes && npm run check:core-boundary && npm run check:own-names",
        "check:style-classes": "tsx _tools/checkStyleClasses.ts",
        "check:core-boundary": "tsx _tools/checkCoreBoundary.ts",
        "check:own-names": "tsx _tools/checkOwnNames.ts",
        "i18n:bake": "npm run i18n:yaml2json && npm run i18n:bakejson && npm run i18n:format",
        "i18n:bakejson": "tsx _tools/bakei18n.ts",
        "i18n:format": "prettier --config .prettierrc.mjs --write --log-level error 'src/core/common/messagesJson/*.json' 'src/core/common/messages/*.ts'",
        "prei18n:check": "npm run build:core",
        "i18n:check": "tsx _tools/checkTrilingual.ts && tsx _tools/checkNotices.ts",
        "i18n:json2yaml": "tsx _tools/json2yaml.ts",
        "i18n:yaml2json": "tsx _tools/yaml2json.ts",
        "pretest:unit": "npm run build:core",
        "test:unit": "vitest run --config vitest.config.unit.ts && npm run test --workspace @tabularium/sync-core",
        "test:contract:contexts": "vitest run --config vitest.config.unit.ts src/obsidian/services/ObsidianServiceContext.unit.spec.ts",
        "test:contract:context:obsidian": "npm run build && npm run test:e2e:obsidian:smoke",
        "test:integration": "npx dotenv-cli -e .env -e .test.env -- vitest run --config vitest.config.integration.ts",
        "test:unit:coverage": "vitest run --config vitest.config.unit.ts --coverage",
        "test:e2e:obsidian:install-appimage": "tsx test/e2e-obsidian/scripts/install-appimage.ts",
        "test:e2e:obsidian:runner": "vitest run --config vitest.config.e2e-runner.ts",
        "test:docker-couchdb:up": "npx dotenv-cli -e .env -e .test.env -- ./test/shell/couchdb-start.sh",
        "test:docker-couchdb:init": "npx dotenv-cli -e .env -e .test.env -- ./test/shell/couchdb-init.sh",
        "test:docker-couchdb:start": "npm run test:docker-couchdb:up && sleep 5 && npm run test:docker-couchdb:init",
        "test:docker-couchdb:down": "npx dotenv-cli -e .env -e .test.env -- ./test/shell/couchdb-stop.sh",
        "test:docker-couchdb:stop": "npm run test:docker-couchdb:down",
        "test:docker-s3:up": "npx dotenv-cli -e .env -e .test.env -- ./test/shell/minio-start.sh",
        "test:docker-s3:init": "npx dotenv-cli -e .env -e .test.env -- ./test/shell/minio-init.sh",
        "test:docker-s3:start": "npm run test:docker-s3:up && sleep 3 && npm run test:docker-s3:init",
        "test:docker-s3:down": "npx dotenv-cli -e .env -e .test.env -- ./test/shell/minio-stop.sh",
        "test:docker-s3:stop": "npm run test:docker-s3:down",
        "test:docker-all:up": "npm run test:docker-couchdb:up ; npm run test:docker-s3:up",
        "test:docker-all:init": "npm run test:docker-couchdb:init ; npm run test:docker-s3:init",
        "test:docker-all:down": "npm run test:docker-couchdb:down ; npm run test:docker-s3:down",
        "test:docker-all:start": "npm run test:docker-all:up && sleep 5 && npm run test:docker-all:init",
        "test:docker-all:stop": "npm run test:docker-all:down",
        "test:tabularium:settings": "DISPLAY= WAYLAND_DISPLAY= E2E_OBSIDIAN_CLEANUP_STALE_PROCESSES=false tsx --tsconfig tsconfig.json ../../tests/interop/settings.ts",
        "test:tabularium:sorting": "DISPLAY= WAYLAND_DISPLAY= E2E_OBSIDIAN_CLEANUP_STALE_PROCESSES=false tsx --tsconfig tsconfig.json ../../tests/interop/custom-sorting.ts",
        "check:unreachable": "tsx _tools/findUnreachable.ts"
    },
    "keywords": [],
    "author": "Hanae Nanako",
    "license": "MIT",
    "devDependencies": {
        "@codemirror/commands": "6.10.0",
        "@codemirror/lang-markdown": "6.5.0",
        "@codemirror/language": "6.11.3",
        "@emnapi/core": "1.11.1",
        "@emnapi/runtime": "1.11.1",
        "@eslint/js": "^9.39.3",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tsconfig/svelte": "^5.0.8",
        "@types/deno": "^2.5.0",
        "@types/diff-match-patch": "^1.0.36",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^24.10.13",
        "@types/pouchdb": "^6.4.2",
        "@types/pouchdb-adapter-http": "^6.1.6",
        "@types/pouchdb-adapter-idb": "^6.1.7",
        "@types/pouchdb-browser": "^6.1.5",
        "@types/pouchdb-core": "^7.0.15",
        "@types/pouchdb-mapreduce": "^6.1.10",
        "@types/pouchdb-replication": "^6.4.7",
        "@types/transform-pouch": "^1.0.6",
        "@typescript-eslint/parser": "8.69.0",
        "@vitest/coverage-v8": "^4.1.11",
        "@vrtmrz/obsidian-test-session": "0.2.6",
        "chokidar": "^4.0.0",
        "dotenv-cli": "^11.0.0",
        "esbuild": "0.28.1",
        "esbuild-plugin-inline-worker": "^0.1.1",
        "esbuild-svelte": "^0.9.4",
        "eslint": "^9.39.3",
        "eslint-plugin-obsidianmd": "^0.4.1",
        "eslint-plugin-svelte": "^3.19.0",
        "events": "^3.3.0",
        "globals": "^14.0.0",
        "playwright": "^1.58.2",
        "postcss": "^8.5.6",
        "pouchdb-adapter-http": "^9.0.0",
        "pouchdb-adapter-idb": "^9.0.0",
        "pouchdb-adapter-indexeddb": "^9.0.0",
        "pouchdb-adapter-leveldb": "^9.0.0",
        "pouchdb-adapter-memory": "^9.0.0",
        "pouchdb-core": "^9.0.0",
        "pouchdb-errors": "^9.0.0",
        "pouchdb-find": "^9.0.0",
        "pouchdb-mapreduce": "^9.0.0",
        "pouchdb-merge": "^9.0.0",
        "pouchdb-replication": "^9.0.0",
        "pouchdb-utils": "^9.0.0",
        "prettier": "3.8.1",
        "svelte": "5.56.3",
        "svelte-check": "^4.6.0",
        "svelte-eslint-parser": "^1.8.0",
        "svelte-preprocess": "6.0.5",
        "terser": "^5.39.0",
        "tinyglobby": "^0.2.15",
        "transform-pouch": "^2.0.0",
        "tsx": "^4.21.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.69.0",
        "vite": "^8.0.16",
        "vitest": "^4.1.11",
        "yaml": "^2.8.2"
    },
    "dependencies": {
        "@codemirror/state": "6.5.0",
        "@codemirror/view": "6.38.6",
        "@vrtmrz/browser-ui-kit": "0.1.0",
        "@tabularium/sync-core": "0.2.1",
        "@vrtmrz/obsidian-plugin-kit": "0.1.4",
        "@vrtmrz/ui-interactions": "0.1.2",
        "@vrtmrz/value-store": "0.1.0",
        "diff-match-patch": "^1.0.5",
        "highlight.js": "11.11.1",
        "idb": "^8.0.3",
        "katex": "0.19.1",
        "markdown-it": "^14.3.3",
        "mermaid": "11.17.2",
        "minimatch": "^11.0.4",
        "obsidian": "^1.13.1",
        "octagonal-wheels": "^0.1.55",
        "xxhash-wasm-102": "npm:xxhash-wasm@^1.0.2"
    },
    "overrides": {
        "mermaid": {
            "katex": "$katex"
        },
        "obsidian": {
            "moment": "2.31.0"
        },
        "svelte": {
            "devalue": "5.9.3"
        },
        "pouchdb-core": {
            "uuid": "11.1.1"
        },
        "pouchdb-utils": {
            "uuid": "11.1.1"
        }
    },
    "workspaces": [
        "packages/sync-core"
    ],
    "allowScripts": {
        "esbuild@0.28.1": true,
        "leveldown@5.6.0": true,
        "leveldown@6.1.1": true,
        "svelte-preprocess": false
    }
}
